// Reference config for the OpenClaw Gateway running the Bearing Witness
// agent. This is NOT the live config OpenClaw reads — that lives at
// ~/.openclaw/openclaw.json on whatever machine actually runs the
// Gateway during the demo (the GB10 box). Paste the relevant pieces
// there once OpenClaw is confirmed installed on the box.

{
  agents: {
    defaults: {
      sandbox: {
        mode: "all",              // every session sandboxed, no exceptions
        scope: "session",         // one sandbox per session
        backend: "openshell",
        workspaceAccess: "ro",    // agent reads local workspace, never writes to it directly
      },
    },
  },

  plugins: {
    entries: {
      openshell: {
        enabled: true,
        config: {
          from: "openclaw",
          mode: "remote",         // lower per-turn overhead, better for a live demo
          // Egress is closed by excluding/removing the default-open presets
          // (nvidia, openclaw-pricing, optionally huggingface) after onboard,
          // not by a named policy here — see GB10-RUNBOOK.md §05.1:
          //   nemoclaw hack-agent policy exclude nvidia --yes
          //   nemoclaw hack-agent policy remove  openclaw-pricing --yes
          autoProviders: true,
          timeoutSeconds: 60,
        },
      },
    },
  },

  tools: {
    sandbox: {
      tools: {
        // allow non-empty -> everything not listed is auto-blocked
        allow: [
          "diagnose_bearing",
          "check_blockers",
          "get_evidence",
          "submit_decision",
          "test_without_geometry",
          "replay_timeline",
        ],
        deny: [
          "group:fs",
          "group:web",
          "group:runtime",
        ],
      },
    },
  },
}

// Verify once applied on the box, don't just trust the file:
//   openclaw sandbox list
//   openclaw sandbox explain --agent main --json
// Verify egress is actually closed (GB10-RUNBOOK.md §05.1):
//   nemoclaw hack-agent status | grep -E 'integrate\.api\.nvidia\.com|openrouter\.ai' \
//     && echo "STILL EXPOSED" || echo "clean"
